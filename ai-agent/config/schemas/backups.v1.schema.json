{
  "$id": "backups.v1",
  "title": "BackupsV1",
  "description": "DBAAS 备份列表快照。顶层为备份记录数组。",
  "type": "array",
  "items": {
    "type": "object",
    "description": "单条备份记录。",
    "required": [
      "backup_id",
      "task_id",
      "siteId",
      "siteName",
      "service_name",
      "service_type",
      "child_service_name",
      "child_service_type",
      "unit_name",
      "backup_type",
      "size_bytes",
      "storage_type",
      "compress_mode",
      "started_at",
      "finished_at",
      "expires_at",
      "duration_seconds",
      "task_status",
      "task_error",
      "valid_status",
      "remark"
    ],
    "properties": {
      "backup_id": {
        "type": "string",
        "description": "单个备份文件唯一 ID"
      },
      "task_id": {
        "type": "string",
        "description": "产生该备份记录的 DBAAS 任务 ID"
      },
      "siteId": {
        "type": "string",
        "description": "备份所在站点 ID"
      },
      "siteName": {
        "type": "string",
        "description": "备份所在站点名称"
      },
      "service_name": {
        "type": "string",
        "description": "备份所属服务组名称"
      },
      "service_type": {
        "type": "string",
        "description": "备份所属服务组类型"
      },
      "child_service_name": {
        "type": "string",
        "description": "备份所属子服务名称"
      },
      "child_service_type": {
        "type": "string",
        "description": "备份所属子服务类型"
      },
      "unit_name": {
        "type": "string",
        "description": "备份所属单元名称"
      },
      "backup_type": {
        "type": "string",
        "enum": [
          "full",
          "incremental",
          "ddl",
          "snapshot",
          "rdb",
          "table",
          "encrypt"
        ],
        "description": "备份类型"
      },
      "size_bytes": {
        "type": "integer",
        "description": "备份文件大小"
      },
      "storage_type": {
        "type": "string",
        "enum": [
          "NAS",
          "S3"
        ],
        "description": "存储类型"
      },
      "compress_mode": {
        "type": "string",
        "enum": [
          "none",
          "gzip",
          "zstd"
        ],
        "description": "压缩模式"
      },
      "started_at": {
        "type": "string",
        "description": "备份开始时间，格式 YYYY-MM-DD HH:mm:ss"
      },
      "finished_at": {
        "type": "string",
        "description": "备份结束时间"
      },
      "expires_at": {
        "type": "string",
        "description": "备份过期时间"
      },
      "duration_seconds": {
        "type": "integer",
        "description": "备份耗时"
      },
      "task_status": {
        "type": "string",
        "enum": [
          "created",
          "running",
          "stopped",
          "canceled",
          "succeeded",
          "timed_out",
          "failed",
          "unknown"
        ],
        "description": "备份任务状态"
      },
      "task_error": {
        "type": "string",
        "description": "任务错误信息"
      },
      "valid_status": {
        "type": "string",
        "enum": [
          "unchecked",
          "checking",
          "valid",
          "invalid",
          "unknown"
        ],
        "description": "备份有效性校验状态"
      },
      "remark": {
        "type": "string",
        "description": "备注"
      }
    }
  }
}
